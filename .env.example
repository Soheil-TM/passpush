# Copy to .env. The password is not an environment variable.
# Put it in ./secrets/admin_password.txt (mode 0600, at least 12 characters).
# Include the published port unless the service is actually on 443.
# A browser sends that port in Host, and any other value gets 421.
PUBLIC_ORIGIN=https://stm.local:8443
# Extra https origins that may open the page, such as the LAN address.
# ALSO_ORIGINS=https://192.168.205.161:8443
TLS_MODE=direct
TLS_CERT_FILE=./certs/tls.crt
TLS_KEY_FILE=./certs/tls.key
# Comma-separated proxy addresses. Required when TLS_MODE=proxy, empty in direct mode.
TRUSTED_PROXY_IPS=
HOST_PORT=8443
# 127.0.0.1 publishes on loopback only. Set 0.0.0.0 to reach the host by its IP.
PUBLISH_ADDR=127.0.0.1
# Optional. Values below the floor (19 MiB, 2 iterations, parallelism 1) refuse to start.
# ARGON2_MEMORY_KIB=19456
# ARGON2_ITERATIONS=2
# ARGON2_PARALLELISM=1
# Optional. Default 65536. Startup fails above 1048576.
# MAX_CIPHERTEXT_BYTES=65536
